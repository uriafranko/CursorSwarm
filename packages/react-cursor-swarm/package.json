{
  "name": "react-cursor-swarm",
  "version": "0.1.0",
  "description": "Wrap any React component and watch a swarm of multiplayer cursors build it live: crosshair-drawn boxes, typed text, pen-tool lines and alt-drag duplicates.",
  "keywords": [
    "animation",
    "cursor",
    "cursors",
    "design-tool",
    "multiplayer",
    "react",
    "reveal",
    "scroll-animation",
    "swarm",
    "typing"
  ],
  "homepage": "https://github.com/uriafranko/CursorSwarm/tree/main/packages/react-cursor-swarm#readme",
  "bugs": {
    "url": "https://github.com/uriafranko/CursorSwarm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uriafranko/CursorSwarm.git",
    "directory": "packages/react-cursor-swarm"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
